.{
    .name = .pg,
    .version = "0.0.0",
    .fingerprint = 0xbd309ff2a41dc5d4, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // The test runner and the benchmark engine. Lazy: only this repo's own
        // build uses it, and build.zig returns before it is fetched for a
        // consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.5.0.tar.gz",
            .hash = "testingx-0.5.0-ib95-9FWAwAzwy03e-h52udEnWkVzuV-gCFJTp1IQ5rV",
            .lazy = true,
        },
        // The org's primitives. `fmt.atoi` is strict where `std.fmt.parseInt`
        // takes a sign and a base; the wire has no such freedom.
        .stdx = .{
            .url = "https://baskingspot.dev/stdx/v0.6.0.tar.gz",
            .hash = "stdx-0.6.0-CcWegpsXEQBPvqhuSRRDiRjq08s5gXavvTuvoL-Bo3BE",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
